*.pdf
*.tif
*.tiff
*.nc
*.gpkg
*.pbf
*.xlsx
*.xls
*.zip

# macOS
.DS_Store

# Virtual environments
.venv/
venv/
env/

# Caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Browser-test scratch files (the Playwright tool writes .playwright-mcp/)
.playwright-mcp/

# Local deployment and secrets (Vercel CLI writes .vercel/)
.vercel/
.env
.env.*
